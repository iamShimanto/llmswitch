# Copy to .env and fill in. Every provider key is optional —
# only providers with a key set become "connected".

PORT=6000
DATA_DIR=./data
LOG_LEVEL=info

# --- Providers (add the ones you have) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
XAI_API_KEY=

# Optional base-URL overrides
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Security ---
# Bind address (default 127.0.0.1 = localhost only). Set HOST=0.0.0.0 to expose on LAN.
# HOST=127.0.0.1
# When set, /api/* management endpoints require this key (x-admin-key header or Bearer).
# ADMIN_KEY=

# --- Budgets: warn (default) or block with 402 ---
# BUDGET_ACTION=warn

# --- Semantic cache (opt-in, TF-IDF, no external deps) ---
# SEMANTIC_CACHE=1
# SEMANTIC_CACHE_THRESHOLD=0.92

# --- Privacy: PII redaction in inspector (default on) ---
# PII_REDACT=0

# --- Alerts: webhook URL for provider-down alerts ---
# ALERT_WEBHOOK_URL=https://...

# --- Web search (Tavily default, or Brave) ---
# SEARCH_API_KEY=
# SEARCH_PROVIDER=tavily
# Allow /v1/web/fetch to fetch private/loopback IPs (tests only — keep off in prod)
# ALLOW_PRIVATE_FETCH=1

# --- P1 extra providers (all optional) ---
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# DASHSCOPE_API_KEY=
# MINIMAX_API_KEY=
# PERPLEXITY_API_KEY=
# COHERE_API_KEY=
# SILICONFLOW_API_KEY=
# NEBIUS_API_KEY=
# SAMBANOVA_API_KEY=
# NOVITA_API_KEY=
